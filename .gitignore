# ─── Dependencies ────────────────────────────────────────
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Testing & Coverage ─────────────────────────────────
/coverage
*.lcov

# ─── Next.js ────────────────────────────────────────────
/.next/
/out/
/build

# ─── Environment Variables (NEVER commit secrets) ───────
.env
.env.*
!.env.example

# ─── Database (local dev — SQLite fallback OR Postgres data volume) ──
# SQLite (legacy / ephemeral test envs that override the schema provider)
/db/*.db
/db/*.db-journal
*.sqlite
*.sqlite3
# Local Postgres data volume mounted by docker-compose
/docker/postgres-data/

# ─── Debug & Logs ───────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-debug.log*
*.log
dev.log
server.log
dev.out.log

# ─── Misc ───────────────────────────────────────────────
.DS_Store
*.pem
Thumbs.db

# ─── TypeScript ────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Vercel ────────────────────────────────────────────
.vercel

# ─── IDE / Editor ──────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# ─── OS ────────────────────────────────────────────────
.DS_Store
ehthumbs.db
Desktop.ini

# ─── Project-specific (sandbox/dev artifacts) ──────────
local-*
.claude
.z-ai-config
/skills/
/upload/
/tool-results/
/download/
download/
tests/
.zscripts/
mini-services/

# ─── Prisma generated client (regenerated on install) ──
/prisma/migrations/dev.db*

# Caddyfile (sandbox-specific deployment config)
Caddyfile

# Phase screenshots (dev artifacts)
phase*.png
review-*.png

# Examples (reference code, not part of the app)
/examples/

# Mini-services scaffold
/mini-services/
dev.db
prisma/*.db
