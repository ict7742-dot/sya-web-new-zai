# ─── Database ───────────────────────────────────────────
# PostgreSQL is the only supported engine (see prisma/schema.prisma).
#
# Local dev:
#   1. `docker compose up -d` to start a local Postgres 16 container
#   2. Use the URL below as-is
#   3. Run `bun run db:migrate:dev` to apply migrations (creates tables)
#
# Production / preview deployments:
#   - Neon (https://neon.tech) — free tier, branched databases
#   - Supabase (https://supabase.com) — free tier, bundled with storage/auth
#   - AWS RDS / GCP Cloud SQL — for larger workloads
DATABASE_URL="postgresql://sya:sya@localhost:5432/sya?schema=public"

# ─── Admin Authentication ───────────────────────────────
# Generate a new secret with: openssl rand -hex 32
# This is the ADMIN PASSWORD (compared constant-time on login). It is NOT
# stored in the cookie — successful login mints a 256-bit random session
# token whose scrypt hash is persisted in the AdminSession table, and only
# the raw token is set as an httpOnly cookie. To force-revoke all sessions
# after rotating this secret, call POST /api/auth/revoke { "all": true }.
ADMIN_SECRET="replace-with-your-secret-here"

# ─── Optional: Email Provider (for newsletter sending) ──
# Uncomment and fill in when you're ready to send newsletters.
# RESEND_API_KEY=""
# FROM_EMAIL="connect@systematicyield.in"

# ─── Optional: Analytics ───────────────────────────────
# NEXT_PUBLIC_GA_ID=""
# NEXT_PUBLIC_POSTHOG_KEY=""
