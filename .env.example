# ─── Database ───────────────────────────────────────────
# SQLite local development (default). For production, use PostgreSQL or MySQL.
DATABASE_URL="file:./db/custom.db"

# ─── Admin Authentication ───────────────────────────────
# Generate a new secret with: openssl rand -hex 32
# This protects the /admin dashboard and all admin API endpoints.
ADMIN_SECRET="replace-with-your-secret-here"

# ─── Optional: Email Provider (for newsletter sending) ──
# Uncomment and fill in when you're ready to send newsletters.
# RESEND_API_KEY=""
# FROM_EMAIL="connect@systematicyield.in"

# ─── Optional: Analytics ───────────────────────────────
# NEXT_PUBLIC_GA_ID=""
# NEXT_PUBLIC_POSTHOG_KEY=""
