generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String
  interest  String   // 'account' | 'courses' | 'both'
  message   String?
  source    String   @default("website") // 'website' | 'whatsapp' | 'referral'
  createdAt DateTime @default(now())

  // UTM tracking fields
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  landingPage String?

  @@index([interest])
  @@index([createdAt])
  @@index([utmSource])
}

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String?
  content   String   // Markdown content
  coverImage String?  // URL or path to cover image
  category  String   @default("General") // 'General' | 'Market Analysis' | 'Trading Tips' | 'Course Updates' | 'SEBI Updates'
  author    String   @default("SYA Team")
  published Boolean  @default(false)
  views     Int      @default(0) // increment on each post view, powers "popular posts"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([createdAt])
  @@index([category])
  @@index([views])
}

model NewsletterSubscriber {
  id              String   @id @default(cuid())
  email           String   @unique
  source          String   @default("blog") // 'blog' | 'footer' | 'landing'
  active          Boolean  @default(true)
  unsubscribeToken String  @unique // opaque token for one-click unsubscribe links
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active])
  @@index([createdAt])
  @@index([unsubscribeToken])
}

/// A revocable admin session. The random session token is sent to the client
/// as an httpOnly cookie; only its scrypt hash is persisted here. Sessions can
/// be revoked individually (logout) or in bulk ("log out everywhere"). They
/// also expire automatically after 7 days, but expired rows are not actively
/// purged — they're cheap and a small audit trail.
model AdminSession {
  id         String    @id @default(cuid())
  /// scrypt-hashed session token (hex). Unique so we can look up by hash on
  /// every authenticated request. The raw token NEVER lives in the DB.
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime  // 7 days after createdAt
  /// Null while the session is active. Set the moment the user logs out or is
  /// force-revoked. Subsequent requests with this cookie must fail.
  revokedAt  DateTime?
  /// Best-effort audit fields. IP and UA can be empty in serverless if the
  /// platform doesn't forward headers, so they're nullable.
  ip         String?
  userAgent  String?

  @@index([expiresAt])
  @@index([revokedAt])
}